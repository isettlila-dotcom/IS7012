@page
@model IndexModel
@{
   ViewData["Title"] = "RecruitCat Home";
}

<div class="text-center">
    <h1 class="display-4">RecruitCat</h1>
    <p>Helping great people find great careers.</p>
</div>
<div class="row mt-4">
    <div class="col-md-6">
        <h2>About RecruitCat</h2>
        <p>RecruitCat is a recruiting company that helps job seekers connect with employers.</p>
        <p><strong>Address:</strong> 123 Main Street, Cincinnati, OH 45202</p>
        <p><strong>Phone:</strong> 513-555-1234</p>
    </div>

    <div class="col-md-6">
        <h2>Our Services</h2>
        <p>We help with job placement, resume support, interview preparation, and employer recruiting.</p>
    </div>
<div class="row mt-4">
    <div class="col-md-6">
        <h2>Industries We Serve</h2>
        <p>We specialize in technology, healthcare, business, and finance.</p>
    </div>
<div class="row mt-4">
    <div class="col-md-12">
        <h2>Testimonials</h2>
        <p>"RecruitCat helped me find a job that was a great fit for me." - Sarah M.</p>
        <p>"The recruiting process was simple and helpful." - James T.</p>
    </div>
</div class="row mt-4">
    <div class="col-md-12">
        <h2>How to Apply</h2>
        <p>Applying with RecruitCat is easy. Search our available jobs, submit your application online, and one of our recruiters will contact you about the next steps.</p>
    </div>
<div class="row mt-4">
    <div class="col-md-12">
        <img src="~/images/recruiting.jpg" class="img-fluid" alt="Recruiting team">
    </div>
</div>