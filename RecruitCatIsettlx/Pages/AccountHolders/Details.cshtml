@page
@model RecruitCatIsettlx.Pages.AccountHolders.DetailsModel

@{
    ViewData["Title"] = "Account Holder Details";
}

<h1>Account Holder Details</h1>

<div>
    <h4>Account Holder</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.FirstName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.FirstName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.LastName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.LastName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.DateOfBirth)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.DateOfBirth)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.Email)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AccountHolder.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AccountHolder.PhoneNumber)
        </dd>
    </dl>
</div>

<h4>Bank Accounts</h4>

<table class="table">
    <thead>
        <tr>
            <th>Account Number</th>
            <th>Account Name</th>
            <th>Current Balance</th>
            <th>Is Active</th>
            <th>Date Opened</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.AccountHolder.BankAccounts)
        {
            <tr>
                <td>
                    @item.AccountNumber
                </td>
                <td>
                    @item.AccountName
                </td>
                <td>
                    @item.CurrentBalance.ToString("C")
                </td>
                <td>
                    @item.IsActive
                </td>
                <td>
                    @item.DateOpened
                </td>
            </tr>
        }
    </tbody>
</table>

<h4>
    Total Balance: @Model.AccountHolder.BankAccounts.Sum(b => b.CurrentBalance).ToString("C")
</h4>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.AccountHolder.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>